{
  "env": {
    "KN_DATA_DIR": "./data-live"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/cloud_data.sh\"",
            "async": true,
            "timeout": 1800,
            "statusMessage": "Fetching research data (cloud only)"
          }
        ]
      }
    ]
  }
}
