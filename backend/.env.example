# kotsin-nse configuration. Copy to backend/.env (git-ignored) and fill in.
#
# Every key here is a declared field on config.Settings. An unknown KN_* variable — in this file
# OR in the process environment — fails the boot rather than silently using a default.
#
# ── credentials ────────────────────────────────────────────────────────────────────────────────
# 5paisa has no anonymous market-data feed, so even PAPER mode needs a session.
#
# ⚠ ROTATE FIRST. The previous NSE stack committed all of these, plus the TOTP seed, to git in
#   three separate files (fastAnalayticsKotsin/service/SingletonFivePaisaClient.py,
#   optionProducerJava/.../config/AppConfig.java, and the properties). Anything that has ever been
#   in a public repository is compromised. Generate a new API key and reset the TOTP before use.
KN_FP_CLIENT_CODE=
KN_FP_USER_ID=
KN_FP_PASSWORD=
KN_FP_APP_KEY=
KN_FP_ENCRYPT_KEY=
KN_FP_PIN=
KN_FP_TOTP_SECRET=
KN_FP_APP_SOURCE=23312
# The broker's RMS rejects orders when the declared IP is wrong. Auto-detected if left blank;
# set it explicitly on a box with a stable address.
KN_FP_PUBLIC_IP=

# ── universe ────────────────────────────────────────────────────────────────────────────────────
KN_SEGMENTS=NSE_EQ,NSE_FO
# One symbol per line; blank = every optionable underlying in the scrip master.
# KN_UNIVERSE_FILE=./data/universe.txt
KN_MAX_UNIVERSE=200

# ── service ─────────────────────────────────────────────────────────────────────────────────────
KN_ENV=dev
KN_LOG_LEVEL=INFO
KN_API_HOST=127.0.0.1
KN_API_PORT=8500
KN_DATA_DIR=./data
KN_DB_URL=sqlite+aiosqlite:///./data/kotsin_nse.db
KN_ENGINE_ENABLED=true
KN_FEED_ENABLED=true
KN_BACKFILL_DAYS=30
KN_PAPER_INITIAL_INR=1000000

# ── alerts ───────────────────────────────────────────────────────────────────────────────────────
KN_TELEGRAM_BOT_TOKEN=
KN_TELEGRAM_CHAT_ID=

# ── LIVE_CAPPED caps ─────────────────────────────────────────────────────────────────────────────
# The mode itself is NOT set here — it is a row in the control table and must be armed with an
# expiry through the UI or POST /api/control/mode. These only bound what an armed engine may do.
KN_LIVE_SEGMENTS=NSE_FO
KN_LIVE_MAX_QTY_RUPEES=25000
KN_LIVE_MAX_POSITIONS=2
KN_LIVE_MAX_ORDERS_PER_DAY=6
KN_LIVE_DAILY_LOSS_INR=2000
KN_LIVE_ENTRY_CUTOFF_IST=15:10

# ── cost model ────────────────────────────────────────────────────────────────────────────────────
# Defaults are the MEASURED values on this account, not a published tariff: ₹40/order × 2 was 81%
# of a 0.299% round trip at ₹33,000. Change them only with a bill to cite.
KN_COST_BROKERAGE_PER_ORDER_INR=40
KN_COST_BROKERAGE_PCT=0
KN_SLIPPAGE_BPS_DEFAULT=5
