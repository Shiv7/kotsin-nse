[Unit]
Description=kotsin-nse trading engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kotsin-nse/backend
EnvironmentFile=/home/ubuntu/kotsin-nse/backend/.env
ExecStart=/home/ubuntu/.local/bin/uv run kotsin-nse
Restart=on-failure
# Back off rather than thrash. A crash loop that restarts instantly is how a small problem
# becomes an outage.
RestartSec=30
StartLimitBurst=3
StartLimitIntervalSec=600
# A ceiling that belongs to the machine, not to a number someone remembered.
MemoryMax=1G
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
