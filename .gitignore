# secrets — never commit a credential again
.env
backend/.env
backend/.env.*
!backend/.env.example
*.pem
*.key

# data
backend/data*/
# ...except the holiday list, which is checked-in data the engine needs
!backend/data/
backend/data/*
!backend/data/holidays.txt
# ...and the sector map, which three HotStocks score buckets are computed against
!backend/data/hotstocks-sectors.tsv
backend/**/*.db
backend/**/*.db-wal
backend/**/*.db-shm
*.jsonl
*.parquet

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.import_linter_cache/

# node
node_modules/
# no trailing slash: a committed symlink is a file, and `dir/` ignores directories only (review, 2026-10-03)
frontend/dist
*.tsbuildinfo

# os / editor
.DS_Store
.idea/
.vscode/

# ShinkaEvolve run outputs
backend/evolve/results/

# deploy snapshots — git history is the rollback; deploy.sh keeps the newest 10 locally
deploy/rollbacks/
